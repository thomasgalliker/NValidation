{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Validation": {
    "MissingValidatorBehavior": "Log"
  },
  "NValidation": {
    "ValidatorLifetime": "Singleton",
    "ValidationBehaviors": {
      "Class": "All",
      "Property": "StopAtFirstError"
    }
  }
}
