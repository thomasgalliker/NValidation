<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- The repository compiles clean; keeping it that way is cheaper than triaging a backlog. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Deterministic output on a build server, so the same source produces the same package. -->
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Checks the package's net8.0 and net10.0 targets agree with each other on every pack. Add
         PackageValidationBaselineVersion once 1.0.0 is on nuget.org to also catch breaking changes
         against the published surface. Inert for projects that set IsPackable=false. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

</Project>
